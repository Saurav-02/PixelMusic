    <!-- Word delimiter config -->
    <string name="word_delimiter_section_title">Delimitadores de palavras atuais</string>
    <string name="word_delimiter_section_subtitle">Estas palavras-chave separam nomes de artistas quando cercadas por espaços. Não diferencia maiúsculas de minúsculas. Toque para remover.</string>
    <string name="word_delimiter_empty">Nenhum delimitador de palavra configurado</string>
    <string name="word_delimiter_add_title">Adicionar novo delimitador de palavra</string>
    <string name="word_delimiter_hint">ex.: feat. ou ft.</string>
    <string name="word_delimiter_help_title">Como funcionam os delimitadores de palavras</string>
    <string name="word_delimiter_help_body">Delimitadores de palavras são reconhecidos sem diferenciar maiúsculas de minúsculas quando cercados por espaços.\n\nDelimitadores de um único caractere (como \"x\") exigem espaços dos dois lados para evitar falsos positivos.\n\nExemplos:\n  \"Drake feat. Rihanna\" -&gt; Drake, Rihanna\n  \"Marshmello x Bastille\" -&gt; Marshmello, Bastille\n  \"A vs. B\" -&gt; A, B</string>
    <string name="word_delimiters_screen_title">Delimitadores de palavras</string>
    <string name="word_delimiter_reset_title">Redefinir delimitadores de palavras?</string>
    <string name="word_delimiter_reset_message">Isso limpará todos os seus delimitadores de palavras personalizados e restaurará os padrões. Esta ação não pode ser desfeita.</string>
